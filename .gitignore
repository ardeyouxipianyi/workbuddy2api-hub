# 核心机密数据（千万不能上传到公共仓库）
accounts/*.json
accounts/agent-backups/
!accounts/README.txt

# 运行时日志和用量统计
usage/*.jsonl
usage/*.json
!usage/README.txt
usage/*.bak*

# 运行时日志文件
logs/

# 测试套件输出（tests/run_all.py --logs 落盘的每个套件的完整输出）
suite-logs/

# 便携版内置运行时（仓库只保存纯源码，绿色包通过 Release 发布）
python/
*.zip

# native/ 构建产物（python native/build.py 的产出；引擎源码在仓库里，二进制不入库）
native/wb-agg
native/wb-agg.exe
native/libwb_agg.so
native/libwb_agg.dylib
native/wb_agg.dll
native/tests_json
native/tests_json.exe
native/tests_pricing
native/tests_pricing.exe
native/probe_round
native/probe_round.exe
# 多平台构建的输出根（python native/build_matrix.py --out native/dist）
native/dist/

# 发布打包产物（release 工作流与 wrt/ 脚本的输出，只该出现在 Release 资产里）
dist/
.sdk-cache/
wrt/ipk/
wrt/apk/
# build-apk.sh 把 wb_*.py 暂存进包目录再拷给 SDK，这是构建中间产物
wrt/openwrt/workbuddy2api/files/usr/lib/

# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class

# 系统与编辑器文件
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.codebuddy/

# Local Docker Compose override
docker-compose.override.yml
