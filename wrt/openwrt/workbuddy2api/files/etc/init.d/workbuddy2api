#!/bin/sh /etc/rc.common
# WorkBuddy2API-Hub · OpenWrt 版 服务脚本
#
# 用 procd 常驻 python3 -m wb_proxy（PYTHONPATH 指向 /usr/lib/workbuddy2api），参数全部来自
# UCI（/etc/config/workbuddy2api）。改完 uci commit 后 restart 生效。
#
# 数据（账号凭据 + 用量）在 /etc/workbuddy2api/，已加入 sysupgrade 保留列表。

START=99
STOP=10
USE_PROCD=1

PROG_DIR=/usr/lib/workbuddy2api
# 入口用 -m（#702）：以脚本方式启动时模块名是 __main__，实测常驻多
# 47-54 MB（Windows / aarch64 四套环境一致），512 MB 设备上约 10%。

start_service() {
	local host port accounts_dir usage_dir api_key panel_password stats_ttl
	config_load workbuddy2api
	config_get host main host '0.0.0.0'
	config_get port main port '8788'
	config_get accounts_dir main accounts_dir '/etc/workbuddy2api/accounts'
	config_get usage_dir main usage_dir '/etc/workbuddy2api/usage'
	config_get api_key main api_key ''
	config_get panel_password main panel_password ''
	# 统计缓存 TTL（秒）。应用默认 15s：面板每 5s 轮询、每次缓存过期都要
	# 全量重扫 usage.jsonl（2 万行在 N2840 上约 11-16s），默认值会让进程
	# 长期 100% 忙于重建、面板与代理请求都被拖慢。默认 900（15 分钟）配合
	# 预热器（workbuddy2api-warm，每 2 分钟跑一遍）让面板点开即是毫秒级；
	# 代价是聚合数字最多滞后这么久（「最近请求」表不受影响，它是读文件尾部）。
	# 限额判定不受影响——限额为 0 时那条扫描路径本来就不执行；用了限额的话
	# 这个值别调太大（限额计数也吃这份缓存）。
	config_get stats_ttl main stats_ttl '900'

	mkdir -p "$accounts_dir" "$usage_dir"
	chmod 700 "$accounts_dir" 2>/dev/null

	procd_open_instance
	# --lan 确保监听所有接口时必然带 API Key（没配置就用面板生成并持久化的那个），
	# 否则网关会裸奔在局域网上，谁都能耗账号额度。
	procd_set_param command /usr/bin/python3 -m wb_proxy \
		--lan --host "$host" --port "$port" \
		--accounts-dir "$accounts_dir" --usage-dir "$usage_dir"
	[ -n "$api_key" ] && procd_append_param command --api-key "$api_key"
	[ -n "$panel_password" ] && procd_append_param command --panel-password "$panel_password"
	# procd 的 env 是整组设置：PYTHONPATH 必须和原有变量并成同一行，
	# 否则后一次调用会把前一次的变量清掉。
	procd_set_param env PYTHONPATH="$PROG_DIR" WB_STATS_TTL="$stats_ttl" WB_COUNT_TTL="$stats_ttl"
	# 进程意外退出时自动拉起（60 秒内崩 5 次就放弃，避免刷日志）
	procd_set_param respawn 60 10 5
	# 应用日志走 stderr（[wb-proxy] 行），启动横幅与端口占用等错误走 stdout，
	# 两路都进 syslog：logread -e wb-proxy 可看全部
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	# 服务刚起来时所有统计缓存都是空的，后台立刻预热一轮，免得用户正好在这时
	# 点开面板要等一次全表扫描（重启 / 升级后尤其明显）。预热器默认只在真的
	# 重建过（慢）或失败时才写 syslog。
	( /usr/bin/workbuddy2api-warm --quiet & ) >/dev/null 2>&1
}

stop_service() {
	logger -t workbuddy2api "服务停止"
}

reload_service() {
	logger -t workbuddy2api "配置已重载（restart 后生效）"
}
